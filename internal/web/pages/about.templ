package pages

import "github.com/benpsk/go-starter/internal/web/components"

templ AboutPage(props components.PageProps) {
	@components.Layout(props, AboutContent())
}

templ AboutContent() {
	<section class="pb-6 pt-8 sm:pt-12">
		<div class="rounded-3xl border border-base-300/60 bg-base-100/90 p-7 shadow-xl">
			<p class="badge badge-outline">About</p>
			<h1 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">What this starter gives you</h1>
			<ul class="mt-5 list-disc space-y-2 pl-5 text-base-content/75">
				<li>A composition root in <code>cmd/app</code> that builds every repository and service</li>
				<li>Transport-free domain packages with <code>Service</code> and <code>Repository</code> interfaces</li>
				<li>A postgres layer of per-domain repositories over a shared <code>Querier</code></li>
				<li>Separate JSON API and server-rendered browser transports</li>
				<li>Raw SQL migrations and seeders with an embedded fallback</li>
				<li>templ pages and components with htmx boosted navigation</li>
				<li>Tailwind + DaisyUI + Chart.js asset pipeline</li>
			</ul>
		</div>
	</section>
}
