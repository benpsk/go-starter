package components

templ Layout(props PageProps, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-light-theme="silk" data-dark-theme="coffee">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ props.FullTitle() }</title>
			<meta name="description" content={ props.Meta.Description }/>
			<meta name="keywords" content={ props.Meta.Keywords }/>
			<meta name="robots" content="index,follow"/>
			<link rel="canonical" href={ props.canonicalURL() }/>
			<meta property="og:site_name" content={ props.Setting.AppName }/>
			<meta property="og:title" content={ props.FullTitle() }/>
			<meta property="og:description" content={ props.Meta.Description }/>
			<meta property="og:type" content={ props.resolvedType() }/>
			<meta property="og:url" content={ props.canonicalURL() }/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ props.FullTitle() }/>
			<meta name="twitter:description" content={ props.Meta.Description }/>
			<link rel="stylesheet" href="/static/app.css"/>
			if props.analyticsEnabled() {
				<!-- Google tag (gtag.js) -->
				<script async src={ props.gtagSrc() }></script>
				<script>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
				</script>
			}
		</head>
		<body data-google-tag-id={ props.googleTagID() } class="min-h-screen bg-base-200 text-base-content" hx-boost="true" hx-target="#page-content" hx-indicator="#loading-bar" hx-swap="outerHTML show:window:top">
			<div id="loading-bar" class="bg-primary"></div>
			<div class="pointer-events-none fixed inset-0 -z-10">
				<div class="absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 rounded-full bg-primary/20 blur-3xl"></div>
				<div class="absolute bottom-0 right-0 h-80 w-80 rounded-full bg-secondary/15 blur-3xl"></div>
			</div>
			<div class="mx-auto flex min-h-screen w-full max-w-6xl flex-col px-3 sm:px-6">
				@Header(props.Setting.AppName, props.Auth)
				@MainContent(body)
				@Footer(props.Setting.AppName)
			</div>
			<script defer src="/static/vendor/htmx.min.js"></script>
			<script defer src="/static/vendor/chart.umd.min.js"></script>
			<script defer src="/static/app.min.js"></script>
		</body>
	</html>
}
